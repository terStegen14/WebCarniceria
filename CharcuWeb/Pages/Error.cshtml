@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<section class="container py-5 text-center" style="padding-top:140px !important;">
    <h1 class="fw-bold mb-3">@LangResource["ErrorTitle"]</h1>
    <p class="text-muted">@LangResource["ErrorText"]</p>
    <a asp-page="/Index" class="btn btn-custom">@LangResource["ErrorBack"]</a>
    @if (Model.ShowRequestId)
    {
        <p class="mt-4 small text-muted">ID: <code>@Model.RequestId</code></p>
    }
</section>