@page
@model TradicioCarnica.Pages.IndexModel
@{
    <section class="hero vh-100 d-flex align-items-center text-center text-white"
             style="position:relative; background: linear-gradient(rgba(0,0,0,0.5), rgba(0,0,0,0.5)), url('/images/hero.png') ;">

        <div class="container">

            <h1 class="display-3 fw-bold" style="font-size: 96px; font-weight: 500;">
                Tradició càrnica<br>Sílvia i Víctor

            </h1>
            <p class="lead" style="font-family: 32px">Qualitat i tradició en cada tall des de 1999</p>

            <div class="mt-4">

                <a asp-page="/Catalog/Index" class="btn btn-custom btn-lg me-2">
                    Veure Catàleg
                </a>

                <a href="#categorias" class="btn btn-outline-light btn-lg">
                    Descobreix més
                </a>

            </div>            

        </div>
        <a href="#categorias" class="scroll-down">
            <i class="bi bi-arrow-down-short"></i>
        </a>
    </section>

    <section id="categorias" class="py-5">

        <div class="container text-center">

            <h2 class="mb-5" style="font-size: 64px; font-weight: 500">Les Nostres Categories</h2>
            <p class="lead" style="font-family: 32px">Qualitat superior en cada producte. Treballem amb proveïdors locals de confiança.</p>
            <div class="row g-4">

                <div class="col-md-6">
                    <div class="custom-card">
                        <div class="card-img-wrapper">
                            <img src="/images/carnes.png" class="custom-card-img">
                        </div>
                        <div class="card-info">
                            <h5 style="font-size: 40px; font-weight: 600">Carns Fresques</h5>
                            <p style="font-size: 24px">Vadella, porc i xai de primera qualitat. Seleccionem les millors peces per garantir sabor i tendresa.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="custom-card">
                        <div class="card-img-wrapper">
                            <img src="/images/embutidos.png" class="custom-card-img">
                        </div>
                        <div class="card-info">
                            <h5 style="font-size: 40px; font-weight: 600">Embotits Artesans</h5>
                            <p style="font-size: 24px">Xoriço, llonganissa, botifarra i més. Elaborats seguint receptes tradicionals amb ingredients naturals.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="custom-card">
                        <div class="card-img-wrapper">
                            <img src="/images/jamones.png" class="custom-card-img">
                        </div>
                        <div class="card-info">
                            <h5 style ="font-size: 40px; font-weight: 600">Xarcuteria Selecta</h5>
                            <p style="font-size: 24px">Pernils ibèrics, lomm embotit, cecina i una selecció de formatges de diferents regions.</p>
                        </div>
                    </div>
                </div>

                <div class="col-md-6">
                    <div class="custom-card">
                        <div class="card-img-wrapper">
                            <img src="/images/embutidos.png" class="custom-card-img">
                        </div>
                        <div class="card-info">
                            <h5 style="font-size: 40px; font-weight: 600">Productes Elaborats</h5>
                            <p style="font-size: 24px">Hamburgueses casolanes, mandonguilles, pinxos moruns i d’altres preparats llestos per cuinar.</p>
                        </div>
                    </div>
                </div>
            </div>

        </div>

    </section>

    <section id="nosotros" class="container py-5">
        <div class="row align-items-center">

            <!-- TEXTO -->
            <div class="col-md-6">
                <h2 class="fw-bold mb-3" style="font-size: 40px;">La Nostra Història</h2>
                <p style="font-size: 18px;">
                    Des de 1999, Sílvia i Víctor han servit a la comunitat del mercat amb dedicació i passió. El que va començar com un petit negoci de carns, avui és una carnisseria de referència coneguda per la seva qualitat excepcional i tracte proper.
                </p>
                <p style="font-size: 18px;">
                    Ens enorgulleix mantenir viva la tradició del bon tall, seleccionant personalment cada peça i treballant només amb proveïdors que comparteixen els nostres valors de qualitat i sostenibilitat.
                </p>

                <div class="d-flex gap-4 mt-4">
                    <div class="feature">
                        <div class="icon">∞</div>
                        <p>Més de 35 anys</p>
                    </div>
                    <div class="feature">
                        <div class="icon">❤</div>
                        <p>Producte local</p>
                    </div>
                    <div class="feature">
                        <div class="icon">👥</div>
                        <p>Atenció personalitzada</p>
                    </div>
                </div>
            </div>

            <!-- IMAGEN -->
            <div class="col-md-6 position-relative">
                <img src="/images/hero.png" class="img-fluid rounded shadow">

                <div class="badge-custom">
                    <strong>25+</strong><br>
                    <small>Anys servint a la comunitat</small>
                </div>
            </div>

        </div>
    </section>

    <section id="contacto" class="container py-5">
        <h2 class="text-center fw-bold mb-2" style="font-size: 40px;">Visita'ns</h2>
        <p class="text-center mb-5 text-muted">Som al cor del mercat. Vine a conèixer-nos i descobreix la diferència.</p>

        <div class="row g-4">

            <!-- HORARIO -->
            <div class="col-md-6">
                <div class="info-card p-4">
                    <h4 class="mb-3 d-flex align-items-center gap-2">
                        <span class="info-icon-circle"><i class="bi bi-clock-fill"></i></span>
                        Horari
                    </h4>

                    <div class="schedule">
                        <div class="closed"><span>Diumenge</span><span>Tancat</span></div>
                        <div class="closed"><span>Dilluns</span><span>Tancat</span></div>
                        <div class="active"><span>Dimarts</span><span>8:00 - 14:30</span></div>
                        <div class="active"><span>Dimecres</span><span>8:00 - 14:30</span></div>
                        <div class="active"><span>Dijous</span><span>8:00 - 14:30 / 16:00 - 20:00</span></div>
                        <div class="active"><span>Divendres</span><span>7:00 - 20:00</span></div>
                        <div class="active"><span>Dissabte</span><span>7:00 - 14:30</span></div>
                    </div>

                    <div class="contact mt-4 d-flex flex-column gap-3">
                        <div class="contact-item">
                            <span class="info-icon-circle"><i class="bi bi-telephone-fill"></i></span>
                            <div>
                                <p class="mb-0 text-muted small">Telèfon</p>
                                <strong>933 54 87 20</strong>
                            </div>
                        </div>
                        <div class="contact-item">
                            <span class="info-icon-circle"><i class="bi bi-envelope-fill"></i></span>
                            <div>
                                <p class="mb-0 text-muted small">Email</p>
                                <strong>charcusyv@gmail.com</strong>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- UBICACIÓN -->
            <div class="col-md-6">
                <div class="info-card p-4">
                    <h4 class="mb-3 d-flex align-items-center gap-2">
                        <span class="info-icon-circle"><i class="bi bi-geo-alt-fill"></i></span>
                        Ubicació
                    </h4>
                    <p class="mb-1"><strong>Mercat de Montserrat, Parada 10</strong></p>
                    <p class="text-muted">Via Favència, 247</p>

                    <div class="rounded overflow-hidden">
                        <iframe src="https://maps.google.com/maps?q=Barcelona&t=&z=13&ie=UTF8&iwloc=&output=embed"
                                width="100%" height="400" style="border:0;" loading="lazy">
                        </iframe>
                    </div>
                </div>
            </div>

        </div>
    </section>

