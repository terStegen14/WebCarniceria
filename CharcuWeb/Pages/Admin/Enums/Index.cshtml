@page
@model TradicioCarnica.Pages.Admin.Enums.IndexModel
@{
    ViewData["Title"] = "Tipos";
}

<h2>Tipos</h2>

<ul class="nav nav-pills mb-3">
    @foreach (var d in Model.Discriminators)
    {
        <li class="nav-item">
            <a class="nav-link @(d == Model.Discriminator ? "active" : "")"
               asp-page="Index" asp-route-discriminator="@d">@d</a>
        </li>
    }
</ul>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<a class="btn btn-success mb-3" asp-page="Upsert" asp-route-discriminator="@Model.Discriminator">Nuevo tipo</a>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr><th>Id</th><th>Código</th><th>Nombre</th><th style="width:170px;">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var e in Model.Items)
        {
            <tr>
                <td>@e.Id</td>
                <td>@e.Code</td>
                <td>@e.Name</td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-page="Upsert" asp-route-id="@e.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@e.Id"
                          asp-route-discriminator="@Model.Discriminator" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este tipo?');">
                        <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>