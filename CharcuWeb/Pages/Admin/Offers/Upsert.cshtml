@page "{id:long?}"
@model TradicioCarnica.Pages.Admin.Offers.UpsertModel
@{
    ViewData["Title"] = Model.IsEdit ? "Editar oferta" : "Nueva oferta";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <input type="hidden" asp-for="Offer.Id" />
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Tipo de oferta</label>
        <select asp-for="Offer.OfferType" asp-items="Model.Types" class="form-select"><option value="">-- Selecciona --</option></select>
    </div>

    <div class="mb-3 offer-field" data-field="price">
        <label class="form-label">Precio (€)</label>
        <input asp-for="Offer.Price" type="number" step="0.01" min="0" class="form-control" />
    </div>
    <div class="mb-3 offer-field" data-field="percent">
        <label class="form-label">Descuento (%)</label>
        <input asp-for="Offer.DiscountPercent" type="number" step="0.01" min="0" max="100" class="form-control" />
    </div>
    <div class="row offer-field" data-field="buy get">
        <div class="col-md-6 mb-3 offer-field" data-field="buy">
            <label class="form-label">Unidades que compra</label>
            <input asp-for="Offer.BuyQty" type="number" step="0.01" min="0" class="form-control" />
        </div>
        <div class="col-md-6 mb-3 offer-field" data-field="get">
            <label class="form-label">Unidades gratis</label>
            <input asp-for="Offer.GetQty" type="number" step="0.01" min="0" class="form-control" />
        </div>
    </div>

    <div class="row">
        <div class="col-md-6 mb-3">
            <label class="form-label">Desde</label>
            <input asp-for="Offer.DateFrom" type="date" class="form-control" />
        </div>
        <div class="col-md-6 mb-3">
            <label class="form-label">Hasta (incluido)</label>
            <input asp-for="Offer.DateTo" type="date" class="form-control" />
        </div>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Offer.Active" class="form-check-input" />
        <label asp-for="Offer.Active" class="form-check-label">Activa</label>
    </div>

    <div class="mb-3">
        <label class="form-label">Productos incluidos</label>
        <input type="text" id="productFilter" class="form-control mb-2" placeholder="Filtrar productos..." />
        <div class="border rounded p-2" style="max-height:260px; overflow-y:auto;">
            @foreach (var p in Model.Products)
            {
                <div class="form-check product-item">
                    <input class="form-check-input" type="checkbox" name="SelectedProductIds" value="@p.Id"
                           id="prod-@p.Id" @(Model.SelectedProductIds.Contains(p.Id) ? "checked" : "") />
                    <label class="form-check-label" for="prod-@p.Id">@p.Label</label>
                </div>
            }
        </div>
    </div>

    <button class="btn btn-success">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        const codes = @Json.Serialize(Model.TypeCodes);
        const visible = {
            FIXED_PRICE: ['price'],
            PERCENT: ['percent'],
            BUY_X_GET_Y: ['buy', 'get']
        };

        function updateFields() {
            const code = codes[document.getElementById('Offer_OfferType').value];
            const show = visible[code] || ['price', 'percent', 'buy', 'get'];
            document.querySelectorAll('.offer-field[data-field]').forEach(el => {
                const fields = el.dataset.field.split(' ');
                el.style.display = fields.some(f => show.includes(f)) ? '' : 'none';
            });
        }
        document.getElementById('Offer_OfferType').addEventListener('change', updateFields);
        updateFields();

        document.getElementById('productFilter').addEventListener('input', e => {
            const q = e.target.value.toLowerCase();
            document.querySelectorAll('.product-item').forEach(el => {
                el.style.display = el.textContent.toLowerCase().includes(q) ? '' : 'none';
            });
        });
    </script>
}