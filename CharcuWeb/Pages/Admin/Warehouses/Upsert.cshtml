@page "{id:long?}"
@model TradicioCarnica.Pages.Admin.Warehouses.UpsertModel
@{
    ViewData["Title"] = Model.IsEdit ? "Editar almacén" : "Nuevo almacén";
}

<h2>@ViewData["Title"]</h2>

<form method="post">
    <input type="hidden" asp-for="Warehouse.Id" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>

    <div class="mb-3">
        <label asp-for="Warehouse.Code" class="form-label">Código</label>
        <input asp-for="Warehouse.Code" class="form-control" />
        <span asp-validation-for="Warehouse.Code" class="text-danger"></span>
    </div>
    <div class="mb-3">
        <label asp-for="Warehouse.Name" class="form-label">Nombre</label>
        <input asp-for="Warehouse.Name" class="form-control" />
        <span asp-validation-for="Warehouse.Name" class="text-danger"></span>
    </div>

    <button class="btn btn-success">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}