@page "{id?}"
@model TradicioCarnica.Pages.Admin.Products.UpsertModel

@{
    ViewData["Title"] = Model.IsEdit ? "Editar producto" : "Nuevo producto";
}

<h2>@ViewData["Title"]</h2>

<form method="post" enctype="multipart/form-data">

    <input type="hidden" asp-for="Product.Id" />

    <div class="mb-3">
        <label asp-for="Product.Code" class="form-label"></label>
        <input asp-for="Product.Code" class="form-control" />
        <span asp-validation-for="Product.Code" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label class="form-label">Imagen</label>
        <input asp-for="ImageFile" type="file" class="form-control" />
    </div>
    @if (!string.IsNullOrEmpty(Model.Product.ImgUrl))
    {
        <div class="mb-3">
            <img src="@Model.Product.ImgUrl" style="max-height:150px" />
        </div>
    }

    <div class="mb-3">
        <label class="form-label">Precio</label>
        <input asp-for="Price" class="form-control" type="number" step="0.01" />
        <span asp-validation-for="Price" class="text-danger"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Product.CategoryId" class="form-label">Categoría</label>
        <select asp-for="Product.CategoryId" asp-items="Model.Categories" class="form-select"></select>
    </div>

    <div class="mb-3">
        <label asp-for="Product.PriceUnitId" class="form-label">Unidad</label>
        <select asp-for="Product.PriceUnitId" asp-items="Model.PriceUnits" class="form-select"></select>
    </div>

    <div class="form-check mb-3">
        <input asp-for="Product.Active" class="form-check-input" />
        <label asp-for="Product.Active" class="form-check-label">Activo</label>
    </div>

    <hr />

    <h4>Nombres y descripciones</h4>

    <ul class="nav nav-tabs">

        @for (int i = 0; i < Model.Languages.Count; i++)
        {
            var lang = Model.Languages[i];

            <li class="nav-item">
                <a class="nav-link @(i == 0 ? "active" : "")"
                   data-bs-toggle="tab"
                   href="#lang-@lang.Id">
                    @lang.Code
                </a>
            </li>
        }

    </ul>

    <div class="tab-content border p-3 mb-2">

        @for (int i = 0; i < Model.Languages.Count; i++)
        {
            var lang = Model.Languages[i];

            <div class="tab-pane fade @(i == 0 ? "show active" : "")" id="lang-@lang.Id">

                <div class="mb-3">
                    <label>Nombre</label>
                    <input name="Translations[@lang.Id].Name"
                           value="@Model.Translations[lang.Id].Name"
                           class="form-control" />
                </div>

                <div class="mb-3">
                    <label>Descripción</label>
    <textarea name="Translations[@lang.Id].Description"
          class="form-control">@Model.Translations[lang.Id].Description</textarea>
                </div>

            </div>
        }

    </div>

    <button type="submit" class="btn btn-success">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>

</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}