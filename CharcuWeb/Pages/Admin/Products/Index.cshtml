@page
@model TradicioCarnica.Pages.Admin.Products.IndexModel
@{ ViewData["Title"] = "Productos"; }

<h2>Productos</h2>

<div class="mb-3">
    <a class="btn btn-success" asp-page="Upsert">Nuevo producto</a>
</div>

<form method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input asp-for="Q" class="form-control" placeholder="Buscar por código o nombre..." />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-md-2">
        <select name="Estado" class="form-select">
            <option value="">Todos</option>
            <option value="activos" selected="@(Model.Estado == "activos")">Activos</option>
            <option value="inactivos" selected="@(Model.Estado == "inactivos")">Inactivos</option>
        </select>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Filtrar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="text-muted">@Model.TotalCount producto(s)</p>

<table class="table table-striped table-bordered align-middle">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Nombre</th>
            <th>Categoría</th>
            <th class="text-end">Precio</th>
            <th>Unidad</th>
            <th>Activo</th>
            <th style="width:170px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            var name = p.ProductTranslations?.FirstOrDefault(t => t.LanguageId == Model.LangId)?.Name
                       ?? p.ProductTranslations?.FirstOrDefault()?.Name
                       ?? "Sin nombre";
            var cat = p.Category?.CategoriesTranslations?.FirstOrDefault(t => t.LanguageId == Model.LangId)?.Name
                      ?? p.Category?.CategoriesTranslations?.FirstOrDefault()?.Name ?? "-";
            var price = p.CurrentPrice;

            <tr class="@(p.Active ? "" : "text-muted")">
                <td>@p.Code</td>
                <td>@name</td>
                <td>@cat</td>
                <td class="text-end">@(price.HasValue ? price.Value.ToString("0.00") + " €" : "-")</td>
                <td>@p.PriceUnit?.Code</td>
                <td class="text-center">
                    <input type="checkbox" class="form-check-input toggle-active"
                           data-bs-toggle="modal" data-bs-target="#confirmModal"
                           data-product-id="@p.Id"
                           @(p.Active ? "checked" : "") />
                </td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-page="Upsert" asp-route-id="@p.Id">Editar</a>
                    <a class="btn btn-danger btn-sm" asp-page="Delete" asp-route-id="@p.Id">Eliminar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var pager = new TradicioCarnica.ViewModels.PagerViewModel
    {
        Current = Model.PageNumber,
        TotalPages = Model.TotalPages,
        Query = new Dictionary<string, object?>
        {
            ["Q"] = Model.Q,
            ["CategoryId"] = Model.CategoryId,
            ["Estado"] = Model.Estado
        }
    };
}
<partial name="_Pager" model="pager" />
<div class="modal fade" id="confirmModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <form method="post" asp-page-handler="ToggleActive">
                <div class="modal-header">
                    <h5 class="modal-title">Confirmar cambio de estado</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    ¿Deseas realmente cambiar el estado de este producto?
                    <input type="hidden" name="ProductId" id="modalProductId" />
                    <input type="hidden" name="NewState" id="modalNewState" />
                    <input type="hidden" name="Q" value="@Model.Q" />
                    <input type="hidden" name="CategoryId" value="@Model.CategoryId" />
                    <input type="hidden" name="Estado" value="@Model.Estado" />
                    <input type="hidden" name="PageNumber" value="@Model.PageNumber" />
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancelar</button>
                    <button type="submit" class="btn btn-danger">Sí, cambiar</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('.toggle-active').forEach(cb => {
            cb.addEventListener('click', function (e) {
                e.preventDefault();
                document.getElementById('modalProductId').value = this.dataset.productId;
                document.getElementById('modalNewState').value = !this.checked;
                new bootstrap.Modal(document.getElementById('confirmModal')).show();
            });
        });
    </script>
}