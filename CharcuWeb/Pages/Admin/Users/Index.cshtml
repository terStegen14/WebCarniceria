@page
@model TradicioCarnica.Pages.Admin.Users.IndexModel
@{
    ViewData["Title"] = "Usuarios";
}

<h2>Usuarios</h2>
<a class="btn btn-success mb-3" asp-page="Upsert">Nuevo usuario</a>

@if (!string.IsNullOrEmpty(Model.Error))
{
    <div class="alert alert-danger">@Model.Error</div>
}

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr><th>Email</th><th>Admin</th><th style="width:170px;">Acciones</th></tr>
    </thead>
    <tbody>
        @foreach (var u in Model.Users)
        {
            <tr>
                <td>@u.Email</td>
                <td class="text-center">
                    @if (Model.Admins.Contains(u.Id))
                    {
                        <i class="bi bi-check-circle-fill text-success"></i>
                    }
                </td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-page="Upsert" asp-route-id="@u.Id">Editar</a>
                    <form method="post" asp-page-handler="Delete" asp-route-id="@u.Id" class="d-inline"
                          onsubmit="return confirm('¿Eliminar este usuario?');">
                        <button class="btn btn-danger btn-sm">Eliminar</button>
                    </form>
                </td>
            </tr>
        }
    </tbody>
</table>