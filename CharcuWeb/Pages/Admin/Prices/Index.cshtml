@page
@model TradicioCarnica.Pages.Admin.Prices.IndexModel
@{ ViewData["Title"] = "Precios"; }

<h2>Precios</h2>

<form method="get" class="row g-2 mb-3 align-items-center">
    <div class="col-md-4">
        <input asp-for="Q" class="form-control" placeholder="Buscar por código o nombre..." />
    </div>
    <div class="col-md-3">
        <select asp-for="CategoryId" asp-items="Model.Categories" class="form-select">
            <option value="">Todas las categorías</option>
        </select>
    </div>
    <div class="col-auto">
        <div class="form-check">
            <input asp-for="SinPrecio" class="form-check-input" />
            <label asp-for="SinPrecio" class="form-check-label">Solo sin precio</label>
        </div>
    </div>
    <div class="col-auto">
        <button class="btn btn-primary">Filtrar</button>
        <a asp-page="Index" class="btn btn-outline-secondary">Limpiar</a>
    </div>
</form>

<p class="text-muted">@Model.TotalCount producto(s)</p>

<table class="table table-striped table-bordered">
    <thead class="table-dark">
        <tr>
            <th>Código</th>
            <th>Producto</th>
            <th>Precio actual</th>
            <th>Desde</th>
            <th style="width:170px;">Acciones</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var p in Model.Products)
        {
            var name = p.ProductTranslations?.FirstOrDefault(t => t.LanguageId == Model.LanguageId)?.Name
                       ?? p.ProductTranslations?.FirstOrDefault()?.Name ?? "-";
            var current = p.Prices?.OrderByDescending(x => x.DateFrom).FirstOrDefault();

            <tr class="@(p.Active ? "" : "text-muted")">
                <td>@p.Code</td>
                <td>@name</td>
                <td>
                    @if (current != null)
                    {
                        @(current.Price.ToString("0.00") + " €/" + p.PriceUnit?.Code)
                    }
                    else
                    {
                        <span class="text-muted">Sin precio</span>
                    }
                </td>
                <td>@current?.DateFrom.ToString("dd/MM/yyyy")</td>
                <td>
                    <a class="btn btn-primary btn-sm" asp-page="History" asp-route-id="@p.Id">Historial / Cambiar</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@{
    var pager = new TradicioCarnica.ViewModels.PagerViewModel
    {
        Current = Model.PageNumber,
        TotalPages = Model.TotalPages,
        Query = new Dictionary<string, object?>
        {
            ["Q"] = Model.Q,
            ["CategoryId"] = Model.CategoryId,
            ["SinPrecio"] = Model.SinPrecio ? "true" : null
        }
    };
}
<partial name="_Pager" model="pager" />