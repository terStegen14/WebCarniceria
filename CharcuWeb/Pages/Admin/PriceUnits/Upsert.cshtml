@page "{id?}"
@model TradicioCarnica.Pages.Admin.PriceUnits.UpsertModel

<h2>@(Model.Unit.Id == 0 ? "Nueva unidad" : "Editar unidad")</h2>

<form method="post">

	<input type="hidden" asp-for="Unit.Id" />

	<div class="mb-3">
		<label asp-for="Unit.Code"></label>
		<input asp-for="Unit.Code" class="form-control" />
	</div>

	<div class="mb-3">
		<label asp-for="Unit.Description"></label>
		<input asp-for="Unit.Description" class="form-control" />
	</div>

	<button class="btn btn-success">Guardar</button>
	<a asp-page="Index" class="btn btn-secondary">Cancelar</a>

</form>