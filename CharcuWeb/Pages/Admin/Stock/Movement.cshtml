@page
@model TradicioCarnica.Pages.Admin.Stock.MovementModel
@{
    ViewData["Title"] = "Nuevo movimiento";
}

<h2>Nuevo movimiento</h2>

<form method="post">
    <div asp-validation-summary="All" class="text-danger"></div>

    <div class="mb-3">
        <label class="form-label">Producto</label>
        <select asp-for="Input.ProductId" asp-items="Model.Products" class="form-select"><option value="">-- Selecciona --</option></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Almacén</label>
        <select asp-for="Input.WarehouseId" asp-items="Model.Warehouses" class="form-select"><option value="">-- Selecciona --</option></select>
    </div>

    <div class="mb-3">
        <label class="form-label">Tipo de movimiento</label>
        <select asp-for="Input.MovementType" asp-items="Model.Types" class="form-select"><option value="">-- Selecciona --</option></select>
    </div>

    <div class="mb-3">
        <label class="form-label d-block">Dirección</label>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Input.Direction" value="IN" id="dirIn" />
            <label class="form-check-label" for="dirIn">Entrada (+)</label>
        </div>
        <div class="form-check form-check-inline">
            <input class="form-check-input" type="radio" asp-for="Input.Direction" value="OUT" id="dirOut" />
            <label class="form-check-label" for="dirOut">Salida (−)</label>
        </div>
    </div>

    <div class="mb-3">
        <label class="form-label">Cantidad</label>
        <input asp-for="Input.Quantity" type="number" step="0.01" min="0.01" class="form-control" />
    </div>

    <button class="btn btn-success">Guardar</button>
    <a asp-page="Index" class="btn btn-secondary">Cancelar</a>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}