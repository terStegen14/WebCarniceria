@using Microsoft.Extensions.Localization
@using TradicioCarnica.Resources
@inject IStringLocalizer<Resource> LangResource
<nav id="mainNavbar" class="navbar navbar-expand-lg navbar-dark fixed-top">

    <div class="container-fluid">

        <a class="navbar-brand fw-bold" asp-page="/Index">
            <img src="/images/logo.png" alt="Logo" class="logo-navbar me-4">
            Tradició Carnica Sílvia i Víctor
        </a>

        <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menu">            
            <span class="navbar-toggler-icon"></span>
        </button>

        <div class="collapse navbar-collapse" id="menu">

            <ul class="navbar-nav ms-auto">
                <li class="nav-item">
                    <a class="nav-link" asp-page="/Index">@LangResource["NavbarHome"]</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" asp-page="/Catalog/Index">@LangResource["NavbarCatalog"]</a>
                </li>

                <li class="nav-item">
                    <a class="nav-link" href="#contacto">@LangResource["NavbarContact"]</a>
                </li>
            </ul>

        </div>

    </div>

</nav>